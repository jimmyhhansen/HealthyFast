# Hindrer at Windows' core.autocrlf gjør shell-script til CRLF, noe som gir
# "bad interpreter: /usr/bin/env bash^M" på Mac.
* text=auto

*.sh        text eol=lf
*.rb        text eol=lf
Podfile     text eol=lf
*.podspec   text eol=lf
*.swift     text eol=lf
*.plist     text eol=lf
*.entitlements text eol=lf
*.pbxproj   text eol=lf -diff

*.ps1       text eol=crlf
*.bat       text eol=crlf

# Binærfiler skal aldri linjeskift-konverteres
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.ttf       binary
*.otf       binary
*.jks       binary
*.keystore  binary
*.aab       binary
*.apk       binary
*.ipa       binary
