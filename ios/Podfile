# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Xcode 15+'s Clang Module Verifier chokes on `sign_in_with_apple`
    # 6.1.4's umbrella header, which uses a double-quoted #include instead
    # of angle brackets ("could not build module 'Test'" during pod
    # install's synthetic VerifyModule step). Not a real problem with our
    # code — this only disables the verifier's synthetic self-check, not
    # normal compilation. Safe to drop once the pod ships a fixed umbrella
    # header (check `sign_in_with_apple` changelog before removing).
    target.build_configurations.each do |config|
      config.build_settings['CLANG_ENABLE_MODULE_VERIFIER'] = 'NO'
    end
  end

  # Belt-and-suspenders for the same issue: CLANG_ENABLE_MODULE_VERIFIER =
  # NO above stops `flutter run`'s incremental build from hitting it, but
  # `flutter build ipa`/Archive still runs the VerifyModule step regardless
  # and fails on this pod's actually-invalid umbrella header. Patch the
  # double-quoted #include to angle brackets after every `pod install` so
  # the header is just correct, no matter what the verifier setting does.
  # Safe to drop once `sign_in_with_apple` ships a fixed umbrella header.
  umbrella = File.join(__dir__, 'Pods', 'Target Support Files', 'sign_in_with_apple',
                        'sign_in_with_apple-umbrella.h')
  if File.exist?(umbrella)
    original = File.read(umbrella)
    patched = original.sub(
      '#import "SignInWithApplePlugin.h"',
      '#import <sign_in_with_apple/SignInWithApplePlugin.h>'
    )
    File.write(umbrella, patched) if patched != original
  end
end
